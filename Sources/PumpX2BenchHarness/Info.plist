<dict>
    <key>CFBundleIdentifier</key>
    <string>com.zgranowitz.PumpX2BenchHarness</string>
    <key>CFBundleName</key>
    <string>PumpX2BenchHarness</string>
    <key>CFBundleExecutable</key>
    <string>PumpX2BenchHarness</string>
